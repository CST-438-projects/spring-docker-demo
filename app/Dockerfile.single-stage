# syntax=docker/dockerfile:1
#
# The WRONG way, kept only for the size comparison in DOCKER_DEMO.md.
# One stage: the final image ships the whole JDK, the Gradle distribution,
# the dependency cache, and your source tree. Build it with:
#   docker build -f Dockerfile.single-stage -t hello-api:single .
FROM eclipse-temurin:21-jdk
WORKDIR /app
COPY . .
RUN chmod +x gradlew && ./gradlew bootJar --no-daemon --quiet
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "build/libs/app.jar"]
